# DataLensAI Backend Environment Variables
PROJECT_NAME="DataLensAI API"
VERSION="0.1.0"
API_V1_STR="/api/v1"

# Security (Generate a strong random string in production)
SECRET_KEY="supersecret_datalensai_jwt_secret_key_change_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database URL
# Default SQLite for instant local development:
DATABASE_URL="sqlite:///./datalens.db"
# For Supabase PostgreSQL, replace with your connection string:
# DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres"

# Groq API Key (We will use this in Phase 4)
# GROQ_API_KEY="your_groq_api_key_here"
